#!/usr/bin/env ruby

require "dotenv"
require "openai"
require "reline"
require "word_wrap"

Dotenv.load(".env", "~/.chatai.env")

OpenAI.configure do |config|
  if ENV.key?("CHATAI_URI")
    config.uri_base = ENV.fetch("CHATAI_URI")
  else
    config.access_token = ENV.fetch("CHATAI_API_KEY") do |name|
      print "OpenAI API Key: "
      gets.chomp
    end
  end
end

def chat(openai, messages)
  parameters = {
    model: ENV.fetch("CHATAI_MODEL", "gpt-3.5-turbo"),
    messages: messages,
    temperature: 0.7
  }
  begin
    res = openai.chat(parameters: parameters)
  rescue Net::ReadTimeout
    retry
  rescue Errno::ECONNRESET
    retry
  end
  if (err = res.dig("error", "message"))
    puts err
    exit 1
  end
  res.dig("choices", 0, "message", "content").strip
end

def fmt(text)
  WordWrap.ww(text, 80)
end

openai = OpenAI::Client.new
options = {}
ARGV.each do |arg|
  case arg
  when "--server", "-s"
    options[:server] = true
  end
end

def token_count(messages)
  context = messages.reduce("") { |ctx, msg| ctx + msg[:content] }
  OpenAI.rough_token_count(context)
end

prompt = ENV.fetch("CHATAI_PROMPT", "You are a helpful and concise assistant")

if options[:server]
  port = ENV.fetch("CHATAI_PORT", "4242").to_i
  server = TCPServer.new(port)
  loop do
    Thread.start(server.accept) do |client|
      messages = [{ role: "system", content: prompt }]
      loop do
        question = client.gets&.chomp
        break if question.nil?

        messages << { role: "user", content: question }
        answer = chat(openai, messages)
        puts "#{client.peeraddr[3]} - - [#{Time.new}] #{token_count(messages)}"
        client.puts
        client.puts fmt(answer)
        client.puts
        messages << { role: "assistant", content: answer }
      end
    rescue => e
      puts "Error: #{e.message}"
    ensure
      client.close
    end
  end
else
  messages = [{ role: "system", content: prompt }]
  if $stdin.tty?
    begin
      loop do
        question = Reline.readline("\x1b[36m>\x1b[0m ")
        break if question.nil? || question == "quit"

        Reline::HISTORY << question
        messages << { role: "user", content: question }
        answer = chat(openai, messages)
        puts fmt(answer)
        puts
        messages << { role: "assistant", content: answer }
      end
    rescue SignalException
      puts
    end
  else
    messages << { role: "user", content: ARGF.read }
    answer = chat(openai, messages)
    puts fmt(answer)
  end
end
